<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    android:versionCode="1"
    android:versionName="1.0"
    android:compileSdkVersion="36"
    android:compileSdkVersionCodename="16"
    package="ar.axt.nopeby"
    platformBuildVersionCode="36"
    platformBuildVersionName="16">
    <uses-sdk
        android:minSdkVersion="16"
        android:targetSdkVersion="36"/>
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32"/>
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29"/>
    <application
        android:theme="@style/AppTheme.Fullscreen"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:requestLegacyExternalStorage="true"
        android:allowBackup="true"
        android:supportsRtl="true"
        android:extractNativeLibs="true"
        android:fullBackupContent="@xml/backup_rules"
        android:resizeableActivity="true"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:appComponentFactory="androidx.core.app.CoreComponentFactory"
        android:dataExtractionRules="@xml/data_extraction_rules">
        <activity
            android:label="@string/app_name"
            android:name="ar.axt.nopeby.Presentacion"
            android:exported="true"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <activity
            android:name="ar.axt.nopeby.MainActivity"
            android:exported="false"
            android:screenOrientation="landscape"/>
        <activity
            android:name="ar.axt.nopeby.Menu"
            android:exported="false"
            android:screenOrientation="landscape"/>
        <activity
            android:name="ar.axt.nopeby.NewProject"
            android:exported="false"
            android:screenOrientation="landscape"/>
        <activity
            android:name="ar.axt.nopeby.ProyectosGuardados"
            android:exported="false"
            android:screenOrientation="landscape"/>
        <service
            android:name="ar.axt.servicios.CleanupService"
            android:stopWithTask="false"/>
    </application>
</manifest>
